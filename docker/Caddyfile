{
	frankenphp {
		# Allow up to 200 concurrent PHP threads.
		max_threads 200
	}
}

# Internal Mercure hub — bound to loopback only so it is never reachable from
# outside the container.  A single hub instance is required so that events
# PHP publishes on this port reach the browser clients that subscribe through
# the main site block (which reverse-proxies /.well-known/mercure here).
# Using a fixed internal HTTP port means PHP can always publish via
# http://127.0.0.1:2099 regardless of whether the outer site uses HTTP or HTTPS.
:2099 {
	bind 127.0.0.1
	mercure {
		publisher_jwt {$MERCURE_JWT_SECRET} HS256
		subscriber_jwt {$MERCURE_JWT_SECRET} HS256
		anonymous
	}
}

# SERVER_NAME controls the domain and TLS behaviour:
#   SERVER_NAME=roadstatus.yourcounty.gov   → auto-TLS via Let's Encrypt (port 443)
#   SERVER_NAME=:80                          → HTTP only (use when behind a proxy)
#   SERVER_NAME=localhost                    → local dev, self-signed cert
{$SERVER_NAME:localhost} {
	root * /app/public

	# Proxy Mercure SSE subscriptions to the internal hub.
	# flush_interval -1 ensures SSE events are streamed immediately (no buffering).
	# Clients subscribe here via EventSource; PHP publishes to 127.0.0.1:2099.
	handle /.well-known/mercure* {
		reverse_proxy 127.0.0.1:2099 {
			flush_interval -1
		}
	}

	# api.php must not be gzip-compressed or buffered (streaming JSON responses)
	@streaming {
		path /api.php
	}
	handle @streaming {
		php_server
	}

	# HTML: never cache — proxies must always revalidate so updated
	# script/style version strings in index.html reach browsers promptly.
	@html {
		path *.html
		path /
	}
	header @html Cache-Control "no-cache, must-revalidate"

	# Versioned static assets (app.js?v=…, style.css?v=…): cache aggressively.
	# The query-string version bump is the cache-bust mechanism.
	@versioned {
		query v=*
	}
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	# Everything else: compress, serve files, process PHP
	encode zstd br gzip
	php_server
}
